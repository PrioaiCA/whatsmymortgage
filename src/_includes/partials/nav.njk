<a class="skip-link" href="#main-content">Skip to content</a>
<div class="nav">
  <a class="nav-brand" href="/">
    <span class="brand-mark">{{ logoMark(34) }}</span>
    <span class="nav-brand-text">
      <span class="nav-brand-name">What's My Mortgage</span>
      <span class="nav-brand-tagline">Clarity in Canadian Mortgages</span>
    </span>
  </a>
  <div class="nav-links">
    <details class="nav-dropdown">
      <summary>Calculators {{ icon('chevron-down', 14) }}</summary>
      <div class="nav-dropdown-panel">
        {% for calc in calculators %}
          {% if calc.dropdownFeatured %}
          <a href="/{{ calc.slug }}/" class="nav-dropdown-item">
            <span class="nav-dropdown-icon">{{ icon(calc.icon, 18) }}</span>
            <span>{{ calc.navTitle }}</span>
          </a>
          {% endif %}
        {% endfor %}
        <a href="/calculators/" class="nav-dropdown-item nav-dropdown-all">All calculators →</a>
      </div>
    </details>
    <a href="/learn/" {% if page.url == '/learn/' %}aria-current="page"{% endif %}>Learn</a>
    <a href="/mortgage-glossary/" {% if page.url == '/mortgage-glossary/' %}aria-current="page"{% endif %}>Glossary</a>
    <a href="/sources/" {% if page.url == '/sources/' %}aria-current="page"{% endif %}>Sources &amp; method</a>
  </div>
</div>
