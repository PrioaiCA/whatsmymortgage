<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ canonicalPath or page.url }}">
{% if noindex %}<meta name="robots" content="noindex,follow">{% endif %}

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:url" content="{{ site.url }}{{ canonicalPath or page.url }}">
<meta property="og:image" content="{{ site.url }}{{ ogImage or ('/assets/og/' + (ogSlug or 'default') + '.png') }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle or title }}">
<meta name="twitter:description" content="{{ ogDescription or description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or ('/assets/og/' + (ogSlug or 'default') + '.png') }}">

<meta name="theme-color" content="{{ site.themeColor }}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ec3013'/%3E%3Ctext x='16' y='23' font-family='Arial,sans-serif' font-weight='800' font-size='20' fill='%23f3f2f2' text-anchor='middle'%3E%3F%3C/text%3E%3C/svg%3E">

<link rel="preload" href="/assets/fonts/archivo-variable.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/main.css">

{% if schema %}
<script type="application/ld+json">{{ schema | jsonify | safe }}</script>
{% endif %}
</head>
<body>
{% include "partials/nav.njk" %}
<main id="main-content">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script type="module" src="/assets/js/common.js"></script>
{% if pageScript %}<script type="module" src="{{ pageScript }}"></script>{% endif %}
</body>
</html>
