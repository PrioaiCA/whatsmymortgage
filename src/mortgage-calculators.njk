---
pagination:
  data: calculators
  size: 1
  alias: calc
  addAllPagesToCollections: true
permalink: "{{ calc.slug }}/index.html"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ calc.metaTitle }}"
  description: "{{ calc.metaDescription }}"
  ogSlug: "{{ calc.slug }}"
  intent: "{{ calc.intent }}"
  pageScript: "/assets/js/pages/calc-{{ calc.view }}.js"
  schema:
    "@context": "https://schema.org"
    "@type": "WebApplication"
    name: "{{ calc.metaTitle }}"
    description: "{{ calc.metaDescription }}"
    url: "{{ site.url }}/{{ calc.slug }}/"
    applicationCategory: "FinanceApplication"
    isAccessibleForFree: true
    offers:
      "@type": "Offer"
      price: "0"
      priceCurrency: "CAD"
---
{#
  JOB: produce one number for this situation, in plain terms explain what
  drives it, and offer exactly one next step. Four zones only — input,
  answer, explanation, next — nothing else belongs on this page.
#}
<div class="container calc-page">
  <a class="back-link" href="/">← All calculators</a>
  <h1 class="calc-h1">{{ calc.h1 }}</h1>

  <div class="calc-layout">
    <div class="calc-answer-zone">
      <div class="result-card">
        <div id="result-metrics">{{ calcMetricsHtml(calc.view) }}</div>
        {% if calc.intent == 'high' %}
        <div class="result-details" id="result-contact" style="padding:var(--space-4)">
          {{ contactCardHtml({
            id: 'calc',
            calculatorName: calc.navTitle,
            ctaLabel: calc.ctaLabel,
            intro: "These figures use one rate and general guidelines. A licensed mortgage agent can tell you which lenders would actually take your file, and what " + (calc.navTitle | lower) + " looks like for you specifically.",
            qualifier: calc.intentQualifier
          }) | safe }}
        </div>
        {% endif %}
      </div>
    </div>
    <div class="calc-input-zone card elev-sm" id="calc-form">
      {{ calcForm(calc.view) }}
    </div>
  </div>

  <div class="container-mid calc-explanation-zone">
    <h2>What this number means</h2>
    <p>{{ calc.explainer }}</p>

    {% if calc.intent == 'medium' %}
    <div class="card" style="padding:var(--space-6);border:1px solid var(--color-divider);background:var(--color-bg);margin-top:var(--space-6)">
      {{ contactCardHtml({
        id: 'calc-soft',
        calculatorName: calc.navTitle,
        ctaLabel: calc.ctaLabel,
        intro: "Want a second opinion on this number? A licensed mortgage agent can walk through your specific numbers, at no cost and with no obligation.",
        qualifier: calc.intentQualifier
      }) | safe }}
    </div>
    {% endif %}
  </div>

  <div class="container-mid calc-next-zone">
    <h2>Next</h2>
    <div class="next-links">
      {% for a in learnArticles %}
        {% if a.slug == calc.relatedArticle %}
        <a href="/learn/{{ a.slug }}/" class="next-link">{{ a.title }} →</a>
        {% endif %}
      {% endfor %}
      <a href="{{ calc.nextPage.href }}" class="next-link">{{ calc.nextPage.label }} →</a>
    </div>
  </div>
</div>
